cabal-version: 3.0
name: starter
version: 0.1.0.0
synopsis: Haskell sample package of the polyglot template.
license: MIT
build-type: Simple

library
  exposed-modules: Starter
  hs-source-dirs: src
  build-depends: base >= 4.14 && < 5
  default-language: Haskell2010
  ghc-options: -Wall

executable starter
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >= 4.14 && < 5
    , starter
  default-language: Haskell2010
  ghc-options: -Wall
